{
  "name": "@turntable-titans/client",
  "version": "1.0.0",
  "description": "Frontend client for Turntable Titans",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --schema ../server/prisma/schema.prisma && next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema ../server/prisma/schema.prisma",
    "test": "vitest run"
  },
  "prisma": {
    "schema": "../server/prisma/schema.prisma"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.15.0",
    "jose": "^6.2.17",
    "lucide-react": "^0.309.0",
    "next": "^16.4.6",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
