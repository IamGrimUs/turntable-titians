generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  username      String?      @unique
  name          String?
  image         String?
  externalCrews String[]
  submissions   Submission[]
  internalCrews CrewMember[]
  accounts      Account[]
  sessions      Session[]
  votes         Vote[]
  runoffVotes   RunoffVote[]
  createdAt     DateTime     @default(now())

  ideas            Idea[]
  ideaVotes        IdeaVote[]
  ideaComments     IdeaComment[]
  ideaCommentVotes IdeaCommentVote[]

  role             UserRole  @default(USER)
  suspendedAt      DateTime?
  suspendedUntil   DateTime?
  suspensionReason String?
  lastSignInAt     DateTime  @default(now())

  challengesSent     Challenge[] @relation("ChallengesSent")
  challengesReceived Challenge[] @relation("ChallengesReceived")
  challengeEmails    Boolean     @default(true)
}

enum UserRole {
  USER
  ADMIN
  OWNER
}

model BannedEmail {
  email       String   @id
  reason      String?
  createdAt   DateTime @default(now())
  createdById String?
}

model AdminAuditLog {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  actorId        String
  actorUsername  String?
  actorEmail     String
  action         String
  targetType     String
  targetId       String
  targetUsername String?
  targetEmail    String?
  details        Json

  @@index([createdAt])
}

model Battle {
  id          String       @id @default(cuid())
  title       String
  type        String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      BattleStatus @default(UPCOMING)
  submissions Submission[]
  votes       Vote[]
  runoffVotes RunoffVote[]
  challenge   Challenge?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model Challenge {
  id                 String          @id @default(cuid())
  challengerId       String
  opponentId         String
  title              String
  message            String?
  challengerVideoUrl String
  votingDays         Int
  status             ChallengeStatus @default(PENDING)
  expiresAt          DateTime
  respondedAt        DateTime?
  battleId           String?         @unique
  createdAt          DateTime        @default(now())

  challenger User    @relation("ChallengesSent", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User    @relation("ChallengesReceived", fields: [opponentId], references: [id], onDelete: Cascade)
  battle     Battle? @relation(fields: [battleId], references: [id], onDelete: SetNull)

  @@index([challengerId, createdAt])
  @@index([opponentId, status])
}

model Submission {
  id          String       @id @default(cuid())
  battleId    String
  userId      String
  videoUrl    String
  title       String?
  description String?
  votes       Vote[]
  runoffVotes RunoffVote[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  battle Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One entry per user per battle (also checked in createSubmission for a friendly message).
  @@unique([battleId, userId])
  @@index([userId])
}

model Vote {
  id           String   @id @default(cuid())
  submissionId String
  battleId     String
  userId       String
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  battle     Battle     @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, battleId])
  @@index([battleId])
  @@index([submissionId])
}

model RunoffVote {
  id           String   @id @default(cuid())
  battleId     String
  submissionId String
  userId       String
  createdAt    DateTime @default(now())

  battle     Battle     @relation(fields: [battleId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, battleId])
  @@index([battleId])
  @@index([submissionId])
}

enum BattleStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Crew {
  id        String       @id @default(cuid())
  name      String       @unique
  members   CrewMember[]
  createdAt DateTime     @default(now())
}

model CrewMember {
  userId String
  crewId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  crew Crew @relation(fields: [crewId], references: [id])

  @@id([userId, crewId])
}

// Counters for the sign-in rate limiter (see client/lib/rate-limit.ts).
// Keys are HMAC hashes, so no plaintext emails or IPs are stored here.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime

  @@index([windowStart])
}

// Suggestions board. Separate from Vote on purpose: these votes are public
// counts and have nothing to do with battle votes.
enum IdeaCategory {
  BUG
  SUGGESTION
  OTHER
}

enum IdeaTopic {
  BATTLES
  VOTING
  PROFILES
  LOGIN_ACCOUNT
  SITE_WIDE
}

enum IdeaStatus {
  OPEN
  PLANNED
  IN_PROGRESS
  DONE
  DECLINED
}

model Idea {
  id        String       @id @default(cuid())
  authorId  String
  title     String
  body      String
  category  IdeaCategory
  topic     IdeaTopic?
  status    IdeaStatus   @default(OPEN)
  hiddenAt  DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes    IdeaVote[]
  comments IdeaComment[]

  @@index([category, status])
  @@index([createdAt])
}

model IdeaVote {
  id        String   @id @default(cuid())
  ideaId    String
  userId    String
  createdAt DateTime @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId])
}

model IdeaComment {
  id        String    @id @default(cuid())
  ideaId    String
  authorId  String
  body      String
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())

  idea   Idea              @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  author User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes  IdeaCommentVote[]

  @@index([ideaId])
}

model IdeaCommentVote {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment IdeaComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}
